{
  "name": "research-agent",
  "version": "1.0.0",
  "description": "Personal scientific research agent: monitors PubMed and Europe PMC, extracts study data, and synthesises evidence.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "demo": "node --import ./test/mock-fetch.js server/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "zod": "^4.6.7"
  }
}
