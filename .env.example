# Enables Claude-based extraction and synthesis. Without it the app runs in
# heuristic mode (rule-based extraction only).
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_REFUSAL_FALLBACK=off   # disable server-side refusal fallbacks
# NCBI_API_KEY=                    # raises the PubMed rate limit from 3 to 10 requests/s
# NCBI_EMAIL=                      # contact address NCBI asks API users to send
# PORT=3000
# DATA_DIR=./data
