# The easiest way to connect an AI model is the Settings screen in the app.
# These variables are an alternative for servers and scripts; settings saved
# in the app take priority over them.

# Any provider: anthropic | openai | gemini | openrouter | ollama | custom
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=            # only needed for "custom" (an OpenAI-compatible API)

# Shortcut for Anthropic only
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_REFUSAL_FALLBACK=off   # disable server-side refusal fallbacks

# Optional
# NCBI_API_KEY=           # raises the PubMed rate limit from 3 to 10 requests/s
# NCBI_EMAIL=             # contact address NCBI asks API users to send
# PORT=3000
# DATA_DIR=./data
